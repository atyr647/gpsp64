# gpSP N64 Makefile
# Builds gpSP as a standalone N64 ROM using libdragon SDK
#
# Usage:
#   export N64_INST=$(pwd)/toolchain/opt/libdragon
#   make -f Makefile.n64
#   make -f Makefile.n64 clean

# Default N64_INST to toolchain in repo
N64_INST ?= $(CURDIR)/toolchain/opt/libdragon

# Include libdragon build rules (sets CC, CXX, AS, LD, flags for .z64 targets)
include $(N64_INST)/include/n64.mk

N64_ROM_TITLE = "gpSP GBA Emulator"

# DragonFS filesystem root - put GBA ROMs in filesystem/gba/
N64_MKDFS_ROOT = filesystem

# Extra CFLAGS on top of libdragon's defaults
# HAVE_DYNAREC is defined even though gpSP's MIPS JIT is disabled at
# runtime on N64 (dynarec_enable = 0, its generated code has unresolved
# big-endian bugs).  Removing it reclaims ~1.28 MB -- 896 KB of BSS
# (rom_translation_cache 512K, rom_branch_hash 256K, ram_translation_cache
# 128K) plus ~372 KB of dead code -- but measured 1.4% SLOWER on ares,
# consistently on every window: dropping 417 KB of text shifts everything
# else, and the VR4300 I-cache is direct-mapped, so conflict-miss patterns
# change.  With the Expansion Pak the RAM is free and the framerate is
# not, so it stays in.  Drop it (and the two objects below) if targeting
# a 4 MB console, where the footprint matters more than 1.4%.
CFLAGS += -DN64 -DHAVE_DYNAREC -DMIPS_ARCH
CFLAGS += -DTINY_TRANSLATION_CACHE
CFLAGS += -DROM_BUFFER_SIZE=2
CFLAGS += -DUSE_XBGR1555_FORMAT
# Blit/screen-buffer cache behaviour.  Controlled at 14 windows, frameskip 1:
#   old (cached blit + rgba_buf)          23.81 fps  42.0 ms
#   fused blit + uncached screen          25.00 fps  40.0 ms   (+5.0%)
# An earlier 4-window run showed +17.7%; short window counts over-weight
# boot frames where the blit is a larger share, so quote the 14-window
# figure.  Fitting frame_time = base + render/(interval+1) gives render
# 43 -> 34 ms (-21%), base ~23 ms.  Set N64_BLIT_OPT= to build without.
# The GBA screen buffer and rgba_buf were each 75 KB of *cached* streaming
# writes, so every line cost a write-allocate miss (fetch 16 bytes from
# RDRAM only to overwrite them) plus a writeback.  Together they were ~65%
# of all D-cache misses while rendering.
# N64_RSP_BLIT hands the blit to the RSP entirely.  Measured 33.33 -> 35.71
# fps (+7.1%), output verified against the CPU conversion.
#
# Why the RSP and not the CPU: the blit costs ~11.7 cyc/px but the conversion
# is only ~2-3 of that.  The rest is uncached store throughput -- the
# framebuffer is KSEG1, so every write reaches RDRAM through the write buffer
# with no combining.  The RSP moves it with its own DMA engine while vector
# ops do the conversion, so the CPU is out of the loop.
#
# HARDWARE NOTE: N64_FUSED_BLIT (below) replaced an rdpq_tex_blit with a CPU
# copy and measured +1.1% here -- but ares has no RDP backend, so that RDP
# copy cost ZERO in the measurement while on console it is real work done in
# parallel with the CPU.  That +1.1% may not exist on hardware.  N64_RSP_BLIT
# supersedes both paths and is correct on either, which is why it is the
# default; it also leaves the RDP free for tile rendering later.
N64_BLIT_OPT ?= -DN64_RSP_BLIT -DN64_UNCACHED_SCREEN
CFLAGS += $(N64_BLIT_OPT)

# The game's own software audio mixer.  Two thirds of every emulated
# instruction in Pokemon Emerald belongs to m4a's SoundMainRAM.  See
# n64/m4a_hle.c and docs/HYBRID_PORT.md.
#
# Measured in ares over 8 windows booted from a gameplay savestate:
#   mixer emulated   82.5 ms/f   12.12 fps   CPU 72% PPU 28%
#   mixer skipped    58.0 ms/f   17.24 fps   CPU 58% PPU 42%   (+42.2%)
#
# -DN64_M4A_NATIVE replaces the mixer's four hot loops with native code
# instead of skipping it: 19620 -> 504 interpreted instructions per frame,
# byte-identical output over 900 frames, so the PCM is real and audio can
# be played (-DN64_AUDIO_OUT).  -DN64_M4A_STUB is the skip-it variant.
# Set N64_M4A= to build without either.
#
# Audio output is a separate switch and is off by default: measured in
# ares, calling n64_audio_render_frame() costs 15.5 ms/frame -- 60.5 ->
# 75.5 ms, a fifth of the frame -- and that cost is in gpSP's own output
# path, not in the mixer.  Add -DN64_AUDIO_OUT to turn sound on.
N64_M4A ?= -DN64_M4A_NATIVE
CFLAGS += $(N64_M4A)
# DIAGNOSTIC flags (off by default; re-enable for profiling passes):
#   -DPROFILE_OPCODES  per-insn opcode histogram (~5 cyc/insn overhead)
#   -DPROFILE_PPU      PPU sub-category timers (~few MFC0/scanline)
#   -DPROFILE_AOT      page histogram + BL target counting for AOT HLE
#   -DPROFILE_CYCLES   VR4300 cycle attribution (interp/aot/event/ppu)
# Diagnostics cost real framerate, so they are a build knob rather than
# always-on.  ALL of them are off by default -- PROFILE_AOT used to be on,
# and it was costing 33% of the framerate (15.50 -> 23.26 FPS on ares with
# byte-identical emulation: same instruction counts and same idle/detector
# counts in every window).  It is only three counter updates per
# interpreted instruction, far too little to explain that directly; the
# cost is that touching those globals inside the interpreter's hot loop
# wrecks register allocation and scheduling across the whole dispatch
# switch.  Treat any always-on instrumentation in that loop as expensive
# until measured otherwise.  PROFILE_REGIONS measured a further -16%.
#
# Frame time, the CPU/PPU/blit split, instruction counts and the ARM/Thumb
# mix are always reported and cost nothing extra -- ares_bench.sh needs
# only those, so benchmarking does not require any of these flags.
#   make PROFILE_FLAGS="-DPROFILE_AOT"                 # hot pages/calls
#   make PROFILE_FLAGS="-DPROFILE_CYCLES"              # where cycles go
# Experimental dynarec:  make -f Makefile.n64 N64_JIT=1
#
# Status (measured on ares, this branch):
#   * The JIT executes translated code and completes emulated frames --
#     "JITFRAME 0 exit rv=800003bc" with -DN64_JIT_HEARTBEAT.
#   * It is far too slow to be useful yet: a frame takes seconds, so a
#     benchmark run times out before the 60 frames needed for one PROF
#     window.
#   * It only works when it owns execution from the first frame.
#     -DN64_JIT_WARMUP_FRAMES=N (interpreter for N frames, then hand over)
#     does NOT reach a frame-complete and should not be trusted for
#     anything except bisecting; every "the JIT never returns" observation
#     recorded during this work came from that path.
#   * $gp: the dynarec keeps ARM r13 there, but this build emits
#     gp-relative small-data accesses and libdragon's inthandler is itself
#     gp-relative, so an interrupt landing in translated code sends the
#     handler off to read its state from GBA IWRAM and it re-enters
#     forever.  execute_arm_translate() defers interrupts around the
#     translated-code window to dodge this.  That is a workaround, not a
#     fix -- it also means VI interrupts are deferred for however long a
#     JIT frame takes.  The real fix is -G0 (no gp-relative code, needs
#     libdragon rebuilt) or freeing $gp in the register allocator.
#
# Known standing cost, worth revisiting: commit bd2f569 disabled gpSP's
# memory-access JAL patcher on N64 ("Completely disable patcher sw").
# Normally a GBA load/store goes through a region dispatcher once and then
# patches its own calling JAL so later executions jump straight to the right
# handler; with that removed every memory access pays full dispatch forever,
# and memory ops are a large fraction of all instructions.
#
# It was disabled to stop a crash at 0x04fffed8, attributed to "the D-cache
# write interfering with I-cache".  That address is the same 0x04FFFxxx
# RCP-unmapped signature this branch later traced to the $gp/inthandler
# exception storm, which has nothing to do with the patcher: an interrupt
# landing in translated code sends the handler off to read its state from
# GBA IWRAM, and $sp walks down into RCP space.  So the patcher was very
# likely innocent and can probably be restored now that interrupts are
# deferred around translated code.  Restoring it does need real cache
# maintenance on the patched word (Hit_Write_Back_Invalidate_D then
# Hit_Invalidate_I), which the original code skipped.
#
# Useful diagnostics: -DN64_JIT_HEARTBEAT (frame enter/exit),
# -DN64_JIT_TRACE (block translations, $sp/KSEG1 scanners).
ifeq ($(N64_JIT),1)
CFLAGS += -DN64_DYNAREC_DEFAULT=1
endif

PROFILE_FLAGS ?=
CFLAGS += $(PROFILE_FLAGS)
CFLAGS += -I$(CURDIR) -I$(CURDIR)/n64
CFLAGS += -w   # gpsp has many warnings incompatible with libdragon's -Werror
# VR4300 tuning + LTO.  -flto enables cross-TU inlining (critical for
# memory access helpers called from interpreter).  -fomit-frame-pointer
# frees $fp/$s8 for the register allocator.  Both flags proven in
# picodrive64 and mvs64 N64 emulator projects on this same toolchain.
CFLAGS += -mtune=vr4300 -falign-functions=32 -falign-loops=16
CFLAGS += -flto -fomit-frame-pointer

# EXTRA_CFLAGS: user-supplied flags for A/B testing
# (e.g. `make EXTRA_CFLAGS=-DAOT_PC_MAX=0x08006A58`).
CFLAGS += $(EXTRA_CFLAGS)
CXXFLAGS += $(EXTRA_CFLAGS)
ASFLAGS += $(EXTRA_CFLAGS)

# libdragon's n64.mk appends $(N64_CFLAGS) -- which contains -O2 -- with
# a target-specific rule (`%.z64: CFLAGS+=...`).  Target-specific values
# are appended AFTER everything assigned above, so a plain
# `CFLAGS += -O3` here is silently overridden and the build stays at -O2.
# Re-apply through the same mechanism so these actually win; because
# these lines come after the include, they land last on the command line.
# Measured on ares: -O3 gives 12.82 -> 13.70 FPS (+6.8%, consistent on
# every like-indexed PROF window) for +162 KB of .text.  Worth it even
# though code size otherwise hurts on this target (16 KB I-cache).
N64_OPT ?= -O3
# n64/aot_generated.c is by far the largest object, so its size presses
# directly on the VR4300's 16 KB I-cache.  AOT_OPT builds just that file
# at a different level from the rest (e.g. AOT_OPT=-Os to trade a little
# AOT speed for a smaller footprint); empty means it follows N64_OPT.
AOT_OPT ?=
n64/aot_generated.o: CFLAGS += $(AOT_OPT)

%.z64: CFLAGS   += $(N64_OPT) $(EXTRA_CFLAGS)
%.z64: CXXFLAGS += $(N64_OPT) $(EXTRA_CFLAGS)

CXXFLAGS += $(filter-out -std=gnu17,$(filter -D% -I% -W%,$(CFLAGS))) -w
CXXFLAGS += -fno-rtti -fno-exceptions

ASFLAGS += -DN64 -DHAVE_DYNAREC -DMIPS_ARCH -DTINY_TRANSLATION_CACHE
ASFLAGS += -I$(CURDIR)

# Core emulator objects
OBJS = main.o \
       gba_memory.o \
       savestate.o \
       cpu_threaded.o \
       sound.o \
       cheats.o \
       serial.o \
       gbp.o \
       rfu.o \
       serial_proto.o \
       gba_cc_lut.o \
       memmap.o \
       video.o \
       cpu.o \
       bios_data.o \
       mips/mips_stub.o \
       mips/mips_interp.o \
       n64/n64_interp.o \
       n64/n64_main.o \
       n64/n64_video.o \
       n64/n64_rsp.o \
       rsp_gbascan.o \
       n64/n64_audio.o \
       n64/n64_input.o \
       n64/n64_storage.o \
       n64/aot_hle.o \
       n64/bios_hle.o \
       n64/m4a_hle.o \
       n64/n64_savestate.o \
       n64/aot_generated.o

# Build rules
# If filesystem/ contains files, the .z64 will bundle them as DragonFS
# accessible at rom:/. Otherwise builds without embedded filesystem.
gpsp.z64: gpsp.elf $(if $(wildcard filesystem/*),gpsp.dfs)
gpsp.elf: $(OBJS)

# AOT HLE auto-generation.  Scans the ROM for Thumb function entries
# in the configured hot regions (n64/aot_targets.txt), translates each
# to native C via tools/thumb2c.py, and emits n64/aot_generated.c with:
#   - one C function per Thumb function
#   - a switch-based dispatch
#   - a page bitmap for fast-reject in the interpreter loop
#
# Re-runs whenever the ROM, the targets list, or either Python tool
# changes.  Set AOT_ROM to override the ROM path; defaults to the first
# .gba in filesystem/gba/.
# ROM discovery happens inside the recipe, not in a Make variable:
# GBA ROM filenames routinely contain spaces, and Make's $(firstword)/
# prerequisite syntax cannot represent those.  filesystem/gba/ is checked
# first (that copy is also embedded in the DFS, wanted only for emulator
# testing); a ROM at the repo root is the fallback and drives AOT
# generation *without* being embedded, so a shipping ROM still gets the
# AOT speedup while loading the game from SD card.
AOT_TARGETS = n64/aot_targets.txt
AOT_TOOLS   = tools/thumb2c.py tools/find_thumb_funcs.py tools/scan_targets.py

# Hand-written AOTs in aot_hle.c — exclude from generated dispatch
# so the hand-written fast paths are not shadowed.
AOT_EXCLUDE = --exclude 0x0806F160 --exclude 0x08005ED8

# NOTE: the ROM is deliberately not a prerequisite (see above); the
# targets file and tools drive regeneration.
n64/aot_generated.c: $(AOT_TARGETS) $(AOT_TOOLS)
	@ROM=""; \
	for f in filesystem/gba/*.gba *.gba; do \
	  [ -f "$$f" ] && { ROM="$$f"; break; }; \
	done; \
	if [ -z "$$ROM" ]; then \
	  if grep -q 'aot_gen_' $@ 2>/dev/null; then \
	    echo "    [AOT] no ROM found; keeping existing $@ (not clobbering)"; \
	    touch $@; \
	  else \
	    echo "    [AOT] no ROM found; emitting empty stub (build will be SLOW)"; \
	    printf '#include "../common.h"\n#include "aot_dispatch.h"\nint aot_generated_dispatch(u32 pc, u32 *cycles_used){(void)pc;(void)cycles_used;return 0;}\nconst struct aot_page_ent aot_page_tab[8192];\n' > $@; \
	  fi; \
	else \
	  echo "    [AOT] scanning $$ROM"; \
	  python3 tools/scan_targets.py "$$ROM" $(AOT_TARGETS) > n64/.aot_pcs.tmp; \
	  echo "    [AOT] translating $$(wc -l < n64/.aot_pcs.tmp) candidate functions"; \
	  python3 tools/thumb2c.py "$$ROM" $(AOT_EXCLUDE) --pcs-from n64/.aot_pcs.tmp -o $@; \
	fi

# Force DFS rebuild whenever filesystem contents change
gpsp.dfs: $(shell find filesystem -type f 2>/dev/null)

# C++ files need .cc -> .o rule
%.o: %.cc
	@mkdir -p $(dir $@)
	@echo "    [CXX] $<"
	$(CXX) -c $(CXXFLAGS) -o $@ $<

clean:
	rm -f $(OBJS) $(OBJS:.o=.d) gpsp.elf gpsp.elf.sym gpsp.elf.stripped gpsp.z64

.PHONY: clean

-include $(OBJS:.o=.d)
