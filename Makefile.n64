# gpSP N64 Makefile
# Builds gpSP as a standalone N64 ROM using libdragon SDK
#
# Prerequisites:
#   - libdragon toolchain installed (https://github.com/DragonMinded/libdragon)
#   - N64_INST environment variable set to toolchain path
#
# Usage:
#   make -f Makefile.n64
#   make -f Makefile.n64 clean

include $(N64_INST)/include/n64.mk

# Project name
N64_ROM_TITLE = "gpSP GBA Emulator"
PROG_NAME = gpsp

# Build flags
CFLAGS += -DN64 -DHAVE_DYNAREC -DMIPS_ARCH
CFLAGS += -DTINY_TRANSLATION_CACHE
CFLAGS += -DROM_BUFFER_SIZE=2
CFLAGS += -DUSE_XBGR1555_FORMAT
CFLAGS += -O2 -Wall
CFLAGS += -I. -In64

CXXFLAGS += $(CFLAGS) -fno-rtti -fno-exceptions -std=c++11

# Core emulator sources (no libretro-specific files)
CORE_C_SRCS = \
	main.c \
	gba_memory.c \
	savestate.c \
	sound.c \
	cheats.c \
	serial.c \
	gbp.c \
	rfu.c \
	serial_proto.c \
	gba_cc_lut.c \
	memmap.c

# Note: input.c is excluded (uses libretro API), replaced by n64/n64_input.c
# Note: libretro/libretro.c is excluded, replaced by n64/n64_main.c

CORE_CC_SRCS = \
	video.cc \
	cpu.cc

# Dynarec sources (MIPS)
DYNAREC_C_SRCS = cpu_threaded.c
DYNAREC_ASM_SRCS = \
	bios_data.S \
	mips/mips_stub.S

# N64 platform sources
N64_C_SRCS = \
	n64/n64_main.c \
	n64/n64_video.c \
	n64/n64_audio.c \
	n64/n64_input.c \
	n64/n64_storage.c

# Combine all sources
SRCS = $(CORE_C_SRCS) $(CORE_CC_SRCS) $(DYNAREC_C_SRCS) $(DYNAREC_ASM_SRCS) $(N64_C_SRCS)
OBJS = $(SRCS:.c=.o)
OBJS := $(OBJS:.cc=.o)
OBJS := $(OBJS:.S=.o)

# Build the N64 ROM
$(PROG_NAME).z64: $(PROG_NAME).elf
$(PROG_NAME).elf: $(OBJS)

# Special flags for cpu_threaded.c (suppress warnings from generated code)
cpu_threaded.o: cpu_threaded.c
	$(CC) $(CFLAGS) -Wno-unused-variable -Wno-unused-label -c -o $@ $<

clean:
	rm -f $(OBJS) $(PROG_NAME).elf $(PROG_NAME).z64

.PHONY: clean
