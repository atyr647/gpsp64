# gpSP N64 Makefile
# Builds gpSP as a standalone N64 ROM using libdragon SDK
#
# Usage:
#   export N64_INST=$(pwd)/toolchain/opt/libdragon
#   make -f Makefile.n64
#   make -f Makefile.n64 clean

# Default N64_INST to toolchain in repo
N64_INST ?= $(CURDIR)/toolchain/opt/libdragon

# Include libdragon build rules (sets CC, CXX, AS, LD, flags for .z64 targets)
include $(N64_INST)/include/n64.mk

N64_ROM_TITLE = "gpSP GBA Emulator"

# DragonFS filesystem root - put GBA ROMs in filesystem/gba/
N64_MKDFS_ROOT = filesystem

# Extra CFLAGS on top of libdragon's defaults
# HAVE_DYNAREC is defined even though gpSP's MIPS JIT is disabled at
# runtime on N64 (dynarec_enable = 0, its generated code has unresolved
# big-endian bugs).  Removing it reclaims ~1.28 MB -- 896 KB of BSS
# (rom_translation_cache 512K, rom_branch_hash 256K, ram_translation_cache
# 128K) plus ~372 KB of dead code -- but measured 1.4% SLOWER on ares,
# consistently on every window: dropping 417 KB of text shifts everything
# else, and the VR4300 I-cache is direct-mapped, so conflict-miss patterns
# change.  With the Expansion Pak the RAM is free and the framerate is
# not, so it stays in.  Drop it (and the two objects below) if targeting
# a 4 MB console, where the footprint matters more than 1.4%.
CFLAGS += -DN64 -DHAVE_DYNAREC -DMIPS_ARCH
CFLAGS += -DTINY_TRANSLATION_CACHE
CFLAGS += -DROM_BUFFER_SIZE=2
CFLAGS += -DUSE_XBGR1555_FORMAT
# Blit/screen-buffer cache behaviour.  Controlled at 14 windows, frameskip 1:
#   old (cached blit + rgba_buf)          23.81 fps  42.0 ms
#   fused blit + uncached screen          25.00 fps  40.0 ms   (+5.0%)
# An earlier 4-window run showed +17.7%; short window counts over-weight
# boot frames where the blit is a larger share, so quote the 14-window
# figure.  Fitting frame_time = base + render/(interval+1) gives render
# 43 -> 34 ms (-21%), base ~23 ms.  Set N64_BLIT_OPT= to build without.
# The GBA screen buffer and rgba_buf were each 75 KB of *cached* streaming
# writes, so every line cost a write-allocate miss (fetch 16 bytes from
# RDRAM only to overwrite them) plus a writeback.  Together they were ~65%
# of all D-cache misses while rendering.
# N64_RSP_BLIT hands the blit to the RSP entirely.  Measured 33.33 -> 35.71
# fps (+7.1%), output verified against the CPU conversion.
#
# Why the RSP and not the CPU: the blit costs ~11.7 cyc/px but the conversion
# is only ~2-3 of that.  The rest is uncached store throughput -- the
# framebuffer is KSEG1, so every write reaches RDRAM through the write buffer
# with no combining.  The RSP moves it with its own DMA engine while vector
# ops do the conversion, so the CPU is out of the loop.
#
# HARDWARE NOTE: N64_FUSED_BLIT (below) replaced an rdpq_tex_blit with a CPU
# copy and measured +1.1% here -- but ares has no RDP backend, so that RDP
# copy cost ZERO in the measurement while on console it is real work done in
# parallel with the CPU.  That +1.1% may not exist on hardware.  N64_RSP_BLIT
# supersedes both paths and is correct on either, which is why it is the
# default; it also leaves the RDP free for tile rendering later.
# RE-TESTED after the blit moved to the RSP, on the reasoning that the
# CPU no longer reads the screen buffer back so the uncached alias had
# lost its purpose.  It had not: dropping N64_UNCACHED_SCREEN and adding
# an explicit writeback before the blit measures 55.0 -> 61.0 ms/f, 10.9%
# WORSE.  ~96,000 uncached layer-pixel stores per frame are cheaper than
# the write-allocate misses and line writebacks a cached 75 KB buffer
# costs -- the VR4300's write buffer absorbs streaming stores far better
# than the estimate assumed.  Leave this alone.
# The RDP background and sprite renderer.  ON BY DEFAULT -- set N64_RDP=
# to build the CPU rasteriser instead.  Measured over five link layouts:
# 60.2 ms (16.6 fps) on the CPU, 41.2 ms (24.3 fps) on the RDP, and 34.5
# ms (29.0 fps) with the compiler knobs that the RDP move then unlocked.
# See docs/RDP_RENDERER.md.
#
# N64_RDP_EXEC builds the RDP command list in cached memory and hands it
# over with rdpq_exec(), instead of pushing each rectangle through rspq's
# uncached command buffers.  It was shelved once as "measured worse, but
# ares does not model uncached store stalls so this is unmeasurable
# here".  ares now models them, optionally (GPSP_UNCACHED_WCOST, see
# docs/CACHE_PROFILING.md), and the answer is unambiguous:
#
#   cycles charged per uncached store   0     20    40
#   rspq command buffers (was default)  37.0  39.0  42.0 ms
#   rdpq_exec                           36.0  36.0  36.0 ms
#
# Flat, because it removes ~44,000 uncached accesses per frame -- all of
# the port's uncached traffic; emulation itself has none.  It is no worse
# at zero cost and strictly better at any real cost, and on hardware the
# cost is certainly not zero.
N64_RDP ?= -DN64_RDP_BG -DN64_RDP_EXEC
CFLAGS += $(N64_RDP)

# The RDP renderer takes the RSP blit with it: rspq is a command
# processor running as RSP ucode, so rsp_gbascan and rdpq cannot both be
# loaded.  The blit returns to the CPU, where it now only has to convert
# the rows the RDP declined -- on this workload, none of them.
ifneq ($(findstring N64_RDP_BG,$(N64_RDP)$(EXTRA_CFLAGS)),)
N64_BLIT_OPT ?= -DN64_FUSED_BLIT -DN64_UNCACHED_SCREEN
else
N64_BLIT_OPT ?= -DN64_RSP_BLIT -DN64_UNCACHED_SCREEN
endif
CFLAGS += $(N64_BLIT_OPT)

# The game's own software audio mixer.  Two thirds of every emulated
# instruction in Pokemon Emerald belongs to m4a's SoundMainRAM.  See
# n64/m4a_hle.c and docs/HYBRID_PORT.md.
#
# Measured in ares over 8 windows booted from a gameplay savestate:
#   mixer emulated   82.5 ms/f   12.12 fps   CPU 72% PPU 28%
#   mixer skipped    58.0 ms/f   17.24 fps   CPU 58% PPU 42%   (+42.2%)
#
# -DN64_M4A_NATIVE replaces the mixer's four hot loops with native code
# instead of skipping it: 19620 -> 504 interpreted instructions per frame,
# byte-identical output over 900 frames, so the PCM is real and audio can
# be played (-DN64_AUDIO_OUT).  -DN64_M4A_STUB is the skip-it variant.
# Set N64_M4A= to build without either.
#
# Audio output is a separate switch and is off by default.  Measured in
# ares, calling n64_audio_render_frame() costs 15.5 ms/frame (61.0 ->
# 75.5 ms, a fifth of the frame), and all of it is libdragon's
# audio_push: building with -DN64_AUDIO_NOPUSH, so that the samples are
# still read and resampled but never handed to the AI, measures 61.0
# ms/f -- identical to not producing audio at all.  So the cost is
# neither the mixer nor gpSP's resampling.  Add -DN64_AUDIO_OUT to turn
# sound on.
N64_M4A ?= -DN64_M4A_NATIVE
CFLAGS += $(N64_M4A)
# DIAGNOSTIC flags (off by default; re-enable for profiling passes):
#   -DPROFILE_OPCODES  per-insn opcode histogram (~5 cyc/insn overhead)
#   -DPROFILE_PPU      PPU sub-category timers (~few MFC0/scanline)
#   -DPROFILE_AOT      page histogram + BL target counting for AOT HLE
#   -DPROFILE_CYCLES   VR4300 cycle attribution (interp/aot/event/ppu)
# Diagnostics cost real framerate, so they are a build knob rather than
# always-on.  ALL of them are off by default -- PROFILE_AOT used to be on,
# and it was costing 33% of the framerate (15.50 -> 23.26 FPS on ares with
# byte-identical emulation: same instruction counts and same idle/detector
# counts in every window).  It is only three counter updates per
# interpreted instruction, far too little to explain that directly; the
# cost is that touching those globals inside the interpreter's hot loop
# wrecks register allocation and scheduling across the whole dispatch
# switch.  Treat any always-on instrumentation in that loop as expensive
# until measured otherwise.  PROFILE_REGIONS measured a further -16%.
#
# Frame time, the CPU/PPU/blit split, instruction counts and the ARM/Thumb
# mix are always reported and cost nothing extra -- ares_bench.sh needs
# only those, so benchmarking does not require any of these flags.
#   make PROFILE_FLAGS="-DPROFILE_AOT"                 # hot pages/calls
#   make PROFILE_FLAGS="-DPROFILE_CYCLES"              # where cycles go
# Experimental dynarec:  make -f Makefile.n64 N64_JIT=1
#
# Status (measured on ares, this branch):
#   * The JIT executes translated code and completes emulated frames --
#     "JITFRAME 0 exit rv=800003bc" with -DN64_JIT_HEARTBEAT.
#   * It is far too slow to be useful yet: a frame takes seconds, so a
#     benchmark run times out before the 60 frames needed for one PROF
#     window.
#   * It only works when it owns execution from the first frame.
#     -DN64_JIT_WARMUP_FRAMES=N (interpreter for N frames, then hand over)
#     does NOT reach a frame-complete and should not be trusted for
#     anything except bisecting; every "the JIT never returns" observation
#     recorded during this work came from that path.
#   * $gp: the dynarec keeps ARM r13 there, but this build emits
#     gp-relative small-data accesses and libdragon's inthandler is itself
#     gp-relative, so an interrupt landing in translated code sends the
#     handler off to read its state from GBA IWRAM and it re-enters
#     forever.  execute_arm_translate() defers interrupts around the
#     translated-code window to dodge this.  That is a workaround, not a
#     fix -- it also means VI interrupts are deferred for however long a
#     JIT frame takes.  The real fix is -G0 (no gp-relative code, needs
#     libdragon rebuilt) or freeing $gp in the register allocator.
#
# RESOLVED -- do not re-attempt.  The note below was acted on: commit
# 5f129fe restored the patcher with the cache maintenance the original
# lacked, and 2fba215 reverted it again because it measured 1.9x SLOWER
# (dynarec without patcher ~20.5 N64 cycles per GBA cycle, with it ~39.4,
# eight consecutive readings within 0.5%).  The reasoning below was
# correct -- the patcher really was innocent of the 0x04fffed8 crash --
# and restoring it still lost, most likely because the patch does not
# stick: gpSP patches the JAL to a region-specific handler, so ordinary
# pointer-chasing code lands on the wrong one, returns to the dispatcher
# and is re-patched.  See the long note at mips/mips_emit.h:2779.
#
# Note also from those measurements: the interpreter runs at ~7.9 N64
# cycles per GBA cycle and the dynarec at ~20.5, so the dynarec is
# currently 2.6x SLOWER than the interpreter it would replace.  Full
# speed is 5.56 (93.75 MHz host / 16.78 MHz GBA), so the interpreter is
# within 42% of real-time and the dynarec is nowhere near.
#
# Original note, kept because the diagnosis in it is still right:
# Known standing cost, worth revisiting: commit bd2f569 disabled gpSP's
# memory-access JAL patcher on N64 ("Completely disable patcher sw").
# Normally a GBA load/store goes through a region dispatcher once and then
# patches its own calling JAL so later executions jump straight to the right
# handler; with that removed every memory access pays full dispatch forever,
# and memory ops are a large fraction of all instructions.
#
# It was disabled to stop a crash at 0x04fffed8, attributed to "the D-cache
# write interfering with I-cache".  That address is the same 0x04FFFxxx
# RCP-unmapped signature this branch later traced to the $gp/inthandler
# exception storm, which has nothing to do with the patcher: an interrupt
# landing in translated code sends the handler off to read its state from
# GBA IWRAM, and $sp walks down into RCP space.  So the patcher was very
# likely innocent and can probably be restored now that interrupts are
# deferred around translated code.  Restoring it does need real cache
# maintenance on the patched word (Hit_Write_Back_Invalidate_D then
# Hit_Invalidate_I), which the original code skipped.
#
# Useful diagnostics: -DN64_JIT_HEARTBEAT (frame enter/exit),
# -DN64_JIT_TRACE (block translations, $sp/KSEG1 scanners).
# The dynarec is ON by default.  Measured on the overworld savestate, clean
# builds with no tracing, median of ~60 PROF windows:
#
#   interpreter (the old default)   34.0 ms/frame   29.4 fps
#   interpreter + hblank merge      33.0            30.3
#   dynarec + both levers           28.0            35.7
#
# Build with N64_JIT=0 for the interpreter.
N64_JIT ?= 1
ifeq ($(N64_JIT),1)
CFLAGS += -DN64_DYNAREC_DEFAULT=1
# Batching sound-timer overflows is a 10% win for the dynarec and a 4%
# LOSS for the interpreter, so it is tied to this build rather than being
# a global default.  Override with N64_TIMER_BATCH=.
N64_TIMER_BATCH ?= -DN64_TIMER_BATCH
CFLAGS += $(N64_TIMER_BATCH)
# Indirect-branch inline cache (mips/mips_stub.S).  Block linking already
# patches direct branches straight to their targets, but an indirect
# branch -- BX, POP{pc}, computed jumps -- has no fixed target to patch,
# so each one spilled every ARM register, called into C to walk a hash
# table, and reloaded them.  A one-entry direct-mapped cache per site
# turns a repeat visit into six instructions and no register traffic.
#
# Measured on a cold boot: block_lookup falls from 21.6% of sampled
# instructions to 0%, and the frame cost from 22.0 to 21.5 N64 cycles per
# GBA cycle.  Only 2%, because the PC sampler is instruction-weighted and
# the instructions removed were cheap ones.  Emulation is bit-identical
# (same cpu_ticks at every checkpoint).  Build with N64_JIT_IBCACHE= to
# disable.
N64_JIT_IBCACHE ?= -DN64_JIT_IBCACHE
CFLAGS  += $(N64_JIT_IBCACHE)
ASFLAGS += $(N64_JIT_IBCACHE)
endif

# Hybrid AOT + dynarec: -DN64_JIT_AOT.
#
# tools/thumb2c.py statically recompiles ~690 hot Thumb functions to C
# (n64/aot_generated.c).  That path was only ever dispatched from the Thumb
# interpreter loop in cpu.cc, so it went dark when the dynarec became the
# default.  With this flag the dynarec checks each block's entry PC at
# translate time and, on AOT coverage, emits a call to the native function
# instead of translating.
#
# OFF by default because it is currently a regression:
#
#   dynarec alone        27.14 ms/f   36.8 fps
#   hybrid AOT+dynarec   30.44 ms/f   32.9 fps   +12.2%
#   (326 of 1257 blocks became AOT thunks; rendering identical)
#
# The cause is the memory path, not the code generation -- see
# docs/DYNAREC.md.  An AOT read is a C call through the 32 KB
# memory_map_read table even for IWRAM; an AOT write is a C call into the
# full write_memory32.  Both are dearer than the dynarec's asm stubs, and
# GCC's whole-function optimisation does not cover the difference.  The
# next step is to point aot_read*/aot_write* at those stubs and re-run this
# same experiment.

# Event-schedule levers.  Measured on the overworld savestate over an
# identical 2384-frame window (see docs/DYNAREC.md); dynarec build:
#
#   baseline           7.52 N64 cycles per GBA cycle
#   N64_TIMER_BATCH    6.78   -9.8%
#   N64_MERGE_HBLANK   6.68  -11.1%
#   both               5.75  -23.5%   (real time = 5.56)
#
# Both are opt-in: they trade accuracy for yields.  TIMER_BATCH bursts
# sound DMA and is a 4% LOSS for the interpreter while a 10% win for the
# dynarec; MERGE_HBLANK hides the HBlank flag from the CPU on scanlines
# where no HBlank IRQ or DMA is armed.
#   make -f Makefile.n64 N64_JIT=1 \
#     EXTRA_CFLAGS="-DN64_TIMER_BATCH -DN64_MERGE_HBLANK"
#
# -DN64_EVENT_PROF reports what shortens the CPU window, per frame.

# Worth 11% on its own, to both engines, so it is on for every build.
# Override with N64_MERGE_HBLANK=.
N64_MERGE_HBLANK ?= -DN64_MERGE_HBLANK
CFLAGS += $(N64_MERGE_HBLANK)

PROFILE_FLAGS ?=
CFLAGS += $(PROFILE_FLAGS)
CFLAGS += -I$(CURDIR) -I$(CURDIR)/n64
CFLAGS += -w   # gpsp has many warnings incompatible with libdragon's -Werror
# VR4300 tuning + LTO.  -flto enables cross-TU inlining (critical for
# memory access helpers called from interpreter).  -fomit-frame-pointer
# frees $fp/$s8 for the register allocator.  Both flags proven in
# picodrive64 and mvs64 N64 emulator projects on this same toolchain.
CFLAGS += -mtune=vr4300 -falign-functions=32 -falign-loops=16
CFLAGS += -flto -fomit-frame-pointer

# EXTRA_CFLAGS: user-supplied flags for A/B testing
# (e.g. `make EXTRA_CFLAGS=-DAOT_PC_MAX=0x08006A58`).
CFLAGS += $(EXTRA_CFLAGS)
CXXFLAGS += $(EXTRA_CFLAGS)
ASFLAGS += $(EXTRA_CFLAGS)

# libdragon's n64.mk appends $(N64_CFLAGS) -- which contains -O2 -- with
# a target-specific rule (`%.z64: CFLAGS+=...`).  Target-specific values
# are appended AFTER everything assigned above, so a plain
# `CFLAGS += -O3` here is silently overridden and the build stays at -O2.
# Re-apply through the same mechanism so these actually win; because
# these lines come after the include, they land last on the command line.
# Measured on ares: -O3 gives 12.82 -> 13.70 FPS (+6.8%, consistent on
# every like-indexed PROF window) for +162 KB of .text.  Worth it even
# though code size otherwise hurts on this target (16 KB I-cache).
# -O2, not -O3.  Measured over the whole build from a gameplay savestate:
#   -O3 everywhere   61.0 ms/f   16.39 fps   .text 1,436,828
#   -O2 everywhere   55.0 ms/f   18.18 fps   .text 1,082,892   (+10.9%)
# So -O3 costs a tenth of the frame rate and a quarter of the ROM.  See
# the CPU_OPT note below: -O2 also beats -Os and -O1, so this is not a
# code-size effect and the mechanism is not established -- but it is
# stable in every window and every self-test still passes under it.
# Re-tested with the renderer on the RDP: -O3 for *everything* is 37 / 37
# / 38 / 40 ms, mean 38.0, against 36.5 for -O3 on cpu.cc alone.  So the
# win is specific to the interpreter, not general -- this stays at -O2
# and CPU_OPT carries the -O3.
N64_OPT ?= -O2
# n64/aot_generated.c is by far the largest object, so its size presses
# directly on the VR4300's 16 KB I-cache.  AOT_OPT builds just that file
# at a different level from the rest (e.g. AOT_OPT=-Os to trade a little
# AOT speed for a smaller footprint); empty means it follows N64_OPT.
# MEASURED, and the best single knob left.  Four link layouts:
#
#   AOT_OPT=-Os   34 / 34 / 35 / 35 ms   mean 34.5
#   (unset)       34 / 35 / 38 / 39 ms   mean 36.5
#
# Note the spread as much as the mean: 1 ms against 5.  aot_generated.o
# is the largest object in the build, so shrinking it both reduces
# I-cache pressure and makes the frame time far less sensitive to where
# the linker happens to put everything else -- which is what the cache
# measurements predict (see docs/CACHE_PROFILING.md: about a third of the
# frame is cache-miss stalls).  The AOT code runs interleaved with the
# interpreter, so the two compete for the same 16 KB.
AOT_OPT ?= -Os
n64/aot_generated.o: CFLAGS += $(AOT_OPT)

# Same knob for the interpreter alone.  cpu.cc is one enormous switch per
# instruction set, and a host-side PC profile (GPSP_PCPROF, see
# native/ares_bench.sh) puts 33.6% of the frame inside execute_arm for
# only ~9,560 interpreted instructions -- over 200 VR4300 cycles each,
# where an interpreter should manage 20-40.  Measured from a gameplay
# savestate, with everything else at -O3:
#
#   CPU_OPT=-O2   56.0 ms/f   execute_arm 74,376 bytes
#   CPU_OPT=-Os   60.5 ms/f   execute_arm 66,288 bytes
#   (-O3)         61.0 ms/f   execute_arm 79,076 bytes
#   CPU_OPT=-O1   62.0 ms/f
#
# MECHANISM, now established.  The claim above that "ares's I-cache
# counters report nothing because it recompiles" is wrong: ares models
# both caches fully -- 16 KB direct-mapped I-cache, 8 KB direct-mapped
# D-cache, 16-byte lines, 48 cycles to fill an I-line and 40+40 for a
# dirty D-line -- and charges those cycles in the recompiled path too.
# Only the *hit* counter is gated on homebrew mode.  It also prints a
# D-cache miss histogram and per-PC attribution on stderr for every run,
# needing nothing from the ROM (see docs/CACHE_PROFILING.md).
#
# Measured on the overworld at 37 ms/frame: ~9,550 D-cache misses per
# frame, about 5.7 ms, with I-cache fills on top.  A third of the frame
# is cache-miss stalls.  That is why the interpreter costs ~200 cycles
# per interpreted instruction where scalar work alone predicts 20-40, and
# why four separate attempts to remove work from that loop -- expanding
# AOT coverage, merging HBlank events, deleting the cheat-hook compare,
# giving the idle detector a fast path -- all measured neutral.  The cost
# is not in the instruction stream.
#
# The -Os result is still not fully explained, but it no longer needs a
# special theory: at these miss rates, layout decides the outcome and
# code size does not.
#
# RE-MEASURED after backgrounds and sprites moved to the RDP, and the
# ordering INVERTED.  Four link layouts each, same tree:
#
#   CPU_OPT=-O3   34 / 35 / 38 / 39 ms   mean 36.5
#   CPU_OPT=-O2   37 / 37 / 39 / 51 ms   mean 41.0
#
# -O3 wins on min, median, mean and max.  The old ordering was measured
# while the CPU still rasterised the backgrounds -- a 1,019-instruction
# hot loop competing for the same 16 KB direct-mapped I-cache on every
# scanline.  With that gone the interpreter has the cache mostly to
# itself and can afford the bigger code.  So -O3 is the default here now,
# while N64_OPT stays at -O2 for everything else (not re-tested).
# Two further layout knobs tried against the same mechanism, both worse,
# three link layouts each against the default's 34 / 35 / 35:
#
#   -falign-loops=32               36 / 37 / 37   (the I-cache line is 32
#                                                  bytes; aligning the hot
#                                                  loop to it does not help)
#   -freorder-blocks-algorithm=simple  37 / 38 / 42
#
# Both are documented rather than kept.  Every deliberate layout
# intervention tried on this build has come out worse; the two that did
# help (-O3 here, -Os on the AOT) were found by sweeping existing knobs,
# not by reasoning about cache geometry.  See docs/CACHE_PROFILING.md.
CPU_OPT ?= -O3
cpu.o: CXXFLAGS += $(CPU_OPT)

# The two hand-written AOT entry points (0x0806F160, 0x08005ED8) cost an
# inline PC compare each on EVERY interpreted instruction, and they never
# fire: prof_aot_hw_hits is 0 across all three benchmark workloads --
# cold boot, the intro cutscene and the overworld -- while the generated
# table takes 72K-108K dispatches per run.  Deleting the compares is
# worth 69.0 -> 68.0 ms/f (+1.5%), consistent in every window.
# Set AOT_HANDWRITTEN=1 to build them back in.
ifneq ($(AOT_HANDWRITTEN),1)
CFLAGS += -DAOT_NO_HANDWRITTEN
endif

%.z64: CFLAGS   += $(N64_OPT) $(EXTRA_CFLAGS)
%.z64: CXXFLAGS += $(N64_OPT) $(EXTRA_CFLAGS)

CXXFLAGS += $(filter-out -std=gnu17,$(filter -D% -I% -W%,$(CFLAGS))) -w
CXXFLAGS += -fno-rtti -fno-exceptions

ASFLAGS += -DN64 -DHAVE_DYNAREC -DMIPS_ARCH -DTINY_TRANSLATION_CACHE
ASFLAGS += -I$(CURDIR)

# Core emulator objects
OBJS = main.o \
       gba_memory.o \
       savestate.o \
       cpu_threaded.o \
       sound.o \
       cheats.o \
       serial.o \
       gbp.o \
       rfu.o \
       serial_proto.o \
       gba_cc_lut.o \
       memmap.o \
       video.o \
       cpu.o \
       bios_data.o \
       mips/mips_stub.o \
       mips/mips_interp.o \
       n64/n64_interp.o \
       n64/n64_main.o \
       n64/n64_video.o \
       n64/n64_rsp.o \
       rsp_gbascan.o \
       n64/n64_audio.o \
       n64/n64_input.o \
       n64/n64_storage.o \
       n64/aot_hle.o \
       n64/bios_hle.o \
       n64/m4a_hle.o \
       n64/n64_savestate.o \
       n64/n64_rdp_bench.o \
       n64/n64_rdp_bg.o \
       n64/aot_generated.o

# Build rules
# If filesystem/ contains files, the .z64 will bundle them as DragonFS
# accessible at rom:/. Otherwise builds without embedded filesystem.
gpsp.z64: gpsp.elf $(if $(wildcard filesystem/*),gpsp.dfs)
gpsp.elf: $(OBJS)

# AOT HLE auto-generation.  Scans the ROM for Thumb function entries
# in the configured hot regions (n64/aot_targets.txt), translates each
# to native C via tools/thumb2c.py, and emits n64/aot_generated.c with:
#   - one C function per Thumb function
#   - a switch-based dispatch
#   - a page bitmap for fast-reject in the interpreter loop
#
# Re-runs whenever the ROM, the targets list, or either Python tool
# changes.  Set AOT_ROM to override the ROM path; defaults to the first
# .gba in filesystem/gba/.
# ROM discovery happens inside the recipe, not in a Make variable:
# GBA ROM filenames routinely contain spaces, and Make's $(firstword)/
# prerequisite syntax cannot represent those.  filesystem/gba/ is checked
# first (that copy is also embedded in the DFS, wanted only for emulator
# testing); a ROM at the repo root is the fallback and drives AOT
# generation *without* being embedded, so a shipping ROM still gets the
# AOT speedup while loading the game from SD card.
AOT_TARGETS = n64/aot_targets.txt
AOT_TOOLS   = tools/thumb2c.py tools/find_thumb_funcs.py tools/scan_targets.py

# Hand-written AOTs in aot_hle.c — exclude from generated dispatch
# so the hand-written fast paths are not shadowed.
AOT_EXCLUDE = --exclude 0x0806F160 --exclude 0x08005ED8

# NOTE: the ROM is deliberately not a prerequisite (see above); the
# targets file and tools drive regeneration.
n64/aot_generated.c: $(AOT_TARGETS) $(AOT_TOOLS)
	@ROM=""; \
	for f in filesystem/gba/*.gba *.gba; do \
	  [ -f "$$f" ] && { ROM="$$f"; break; }; \
	done; \
	if [ -z "$$ROM" ]; then \
	  if grep -q 'aot_gen_' $@ 2>/dev/null; then \
	    echo "    [AOT] no ROM found; keeping existing $@ (not clobbering)"; \
	    touch $@; \
	  else \
	    echo "    [AOT] no ROM found; emitting empty stub (build will be SLOW)"; \
	    printf '#include "../common.h"\n#include "aot_dispatch.h"\nint aot_generated_dispatch(u32 pc, u32 *cycles_used){(void)pc;(void)cycles_used;return 0;}\nconst struct aot_page_ent aot_page_tab[8192];\n' > $@; \
	  fi; \
	else \
	  echo "    [AOT] scanning $$ROM"; \
	  python3 tools/scan_targets.py "$$ROM" $(AOT_TARGETS) > n64/.aot_pcs.tmp; \
	  echo "    [AOT] translating $$(wc -l < n64/.aot_pcs.tmp) candidate functions"; \
	  python3 tools/thumb2c.py "$$ROM" $(AOT_EXCLUDE) --pcs-from n64/.aot_pcs.tmp -o $@; \
	fi

# Force DFS rebuild whenever filesystem contents change
gpsp.dfs: $(shell find filesystem -type f 2>/dev/null)

# C++ files need .cc -> .o rule
%.o: %.cc
	@mkdir -p $(dir $@)
	@echo "    [CXX] $<"
	$(CXX) -c $(CXXFLAGS) -o $@ $<

clean:
	rm -f $(OBJS) $(OBJS:.o=.d) gpsp.elf gpsp.elf.sym gpsp.elf.stripped gpsp.z64

.PHONY: clean

-include $(OBJS:.o=.d)
