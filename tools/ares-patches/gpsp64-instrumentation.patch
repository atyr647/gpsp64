 template<u32 Size>
 inline auto CPU::busRead(u32 address) -> u64 {
+  if(address <= 0x03ff'ffff) {
+    int c = gpspUncachedCost(false);
+    if(c) step(c * 2);
+  }
   return bus.read<Size>(address, *this, RBusDevice::VR4300_UNCACHED);
 }
 
