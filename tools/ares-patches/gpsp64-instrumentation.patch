   return devirtualize<Read, Byte>(vaddr, false).paddr; // this wrapper preserves the inlining of 'devirtualizeFast'
 }
 
+/* gpsp64: optional cost for uncached CPU accesses to RDRAM.
+ *
+ * ares charges nothing for these: MI::writeRdram reaches
+ * rdram.ram.write() without stepping the thread, so a burst of uncached
+ * stores is free in the CPU timing model.  On a VR4300 it is not -- the
+ * write buffer is shallow and each access pays RDRAM latency -- and this
+ * port has a concrete decision resting on it.  Building the RDP command
+ * list in cached memory and handing it over with rdpq_exec() removes
+ * ~44,000 uncached accesses a frame; it measured 0.7 ms WORSE here,
+ * which is what "uncached stores are free" predicts, so the change was
+ * shelved as unmeasurable rather than wrong.
+ *
+ * GPSP_UNCACHED_WCOST / GPSP_UNCACHED_RCOST set the per-access charge in
+ * CPU cycles.  Both default to 0, so every measurement taken before this
+ * existed stays comparable; sweeping them says how sensitive a result is
+ * to the real cost instead of guessing a single number.
+ *
+ * Only RDRAM-range addresses are charged.  MMIO registers are uncached
+ * too but have their own latencies and are not what this is for. */
+namespace {
+  inline int gpspUncachedCost(bool write) {
+    static int wcost = -1, rcost = -1;
+    if(wcost < 0) {
+      const char* e = getenv("GPSP_UNCACHED_WCOST");
+      wcost = e ? (int)strtol(e, nullptr, 0) : 0;
+      e = getenv("GPSP_UNCACHED_RCOST");
+      rcost = e ? (int)strtol(e, nullptr, 0) : 0;
+    }
+    return write ? wcost : rcost;
+  }
+}
+
 template<u32 Size>
 inline auto CPU::busWrite(u32 address, u64 data) -> void {
+  if(address <= 0x03ff'ffff) {
+    int c = gpspUncachedCost(true);
+    if(c) step(c * 2);
+  }
   bus.write<Size>(address, data, *this, RBusDevice::VR4300_UNCACHED);
 }
 
