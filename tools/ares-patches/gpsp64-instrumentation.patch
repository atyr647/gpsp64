+  // gpsp64: histogram D-cache misses by 64KB bucket of physical address.
+  // A miss costs 40 CPU cycles here (plus 40 more on a dirty writeback), and
+  // the GBA renderer appears to be stalling ~21 cycles/pixel.  Bucketing by
+  // address says *which* structure is missing -- tile data, tilemaps,
+  // palette, or the destination scanline -- instead of guessing.
+  gpsp_dmiss_hist[(paddr >> 16) & 127]++;
+  gpsp_dmiss_total++;
+  /* gpsp64: the 64KB histogram above says the misses are concentrated in
+   * two buckets -- the stack, and the 64KB small-data window around _gp
+   * where gpSP keeps its globals.  Both are far too coarse to act on: the
+   * D-cache is 8KB direct-mapped, so a 64KB window conflicts with itself
+   * eight times over and "it is the globals" does not say which ones.
+   * This second histogram buckets the same misses at 1KB, which resolves
+   * to individual objects in the link map. */
+  { extern u64 gpsp_dmiss_fine[8192];
+    gpsp_dmiss_fine[(paddr >> 10) & 8191]++; }
