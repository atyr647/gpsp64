+  // is missing is far more actionable than which address: 234KB of the hot
+  // region is anonymous LTO-merged BSS with no symbols, so an address
+  // histogram cannot name it, but a PC resolves straight to a function.
+  {
+    extern u32 gpsp_misspc[512]; extern u32 gpsp_misscnt[512];
+    u32 pc = (u32)cpu.ipu.pc, h = (pc >> 2) & 511;
+    for(u32 i = 0; i < 8; i++) {
+      u32 j = (h + i) & 511;
+      if(gpsp_misspc[j] == pc) { gpsp_misscnt[j]++; break; }
+      if(gpsp_misspc[j] == 0)  { gpsp_misspc[j] = pc; gpsp_misscnt[j] = 1; break; }
+    }
+  }
